name: Participant Purpose
description: >
  Participant-visible declaration of why an actor is present in a document and
  which activities it intends to perform. Purpose is explanatory state, not
  authority, and must never replace mandate verification.

participant:
  type: Coordination/Actor
  schema:
    required: true
  description: Participant whose purpose is described.

statements:
  type: List
  itemType: Coordination/Purpose Statement
  schema:
    required: true
  description: Ordered purpose statements declared by the participant.
