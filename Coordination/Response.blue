name: Response
type: Coordination/Message
description: >
  A Message that answers a Request. A single Request may receive multiple
  Responses, including responses from several participants or successive
  responses from one participant. A Response does not by itself perform an
  operation unless its concrete type and enclosing document contracts define
  that behavior.

inResponseTo:
  type:
    name: Response Correlation
    description: Correlation from a Response to the Request occurrence it answers.
    incomingEvent:
      schema:
        required: true
      description: >
        Pure { blueId: ... } reference to the exact Request occurrence. The
        Request payload is not embedded in the correlation object.
  schema:
    required: true
  description: >
    Required correlation to the exact Coordination/Request occurrence answered
    by this Response.
