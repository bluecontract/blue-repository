name: Response
type: Coordination/Message
description: >
  A Message that answers a Request. A single Request may receive multiple
  Responses, including responses from several participants or successive
  responses from one participant. A Response does not by itself perform an
  operation unless its concrete type and enclosing document contracts define
  that behavior.

inResponseTo:
  type: Coordination/Request
  schema:
    required: true
  description: >
    Required reference to the exact Coordination/Request occurrence answered by
    this Response.
