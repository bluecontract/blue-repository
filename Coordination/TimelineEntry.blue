name: Timeline Entry
description: >
  Immutable entry in an append-only Timeline. The Timeline Provider assigns
  sequence and timestamp, links the entry to its predecessor, and authenticates
  actor attribution. A feeder validates, orders, and filters entries before
  passing eligible events to a processor.

timeline:
  type: Coordination/Timeline
  schema:
    required: true
  description: Timeline containing this entry.

sequence:
  type: Integer
  schema:
    required: true
  description: >
    Monotonically increasing position of this entry within its timeline.

prevEntry:
  type: Coordination/Timeline Entry
  description: >
    Previous entry in the same timeline, normally represented as a pure
    reference. The first entry may omit this field.

timestamp:
  type: Integer
  schema:
    required: true
  description: >
    Microsecond timestamp assigned by the Timeline Provider. The provider must
    preserve its timeline and completeness semantics for this value.

actor:
  type: Coordination/Actor
  schema:
    required: true
  description: Actor attributed as the writer or submitter of this entry.

onBehalfOf:
  type: Mandate/Mandate Authority
  description: >
    Optional mandate-backed authority under which actor claims to act for
    another actor. A feeder validates this authority before delivery when the
    requested action is not directly eligible through a source channel.

message:
  schema:
    required: true
  description: Message or event recorded by the entry.
