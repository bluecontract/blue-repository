name: Document Bootstrap Requested
type: Coordination/Request
description: >
  Request asking the participant addressed by recipientChannel to bootstrap
  the supplied initial document with the requested channel bindings and
  optional initial Messages. The document that emits this request decides how
  and when to emit it.

document:
  schema:
    required: true
  description: Initial document requested for bootstrap.

channelBindings:
  schema:
    required: true
  description: Requested mapping from target document channel keys to participant bindings.

initialMessages:
  type: List
  description: Optional standard bootstrap initial Messages.
