name: MyOS Agent Operation Mandate
type: Mandate/Operation Mandate
description: |
  Reusable Operation Mandate allowing one MyOS Agent Actor to invoke the
  inherited operation for matching target documents on behalf of one MyOS
  Principal Actor. Version 1 requires deterministic static document scope.

  The optional ordered rules list contains owner-readable instructions for a
  constrained MyOS intelligent evaluator. Rules may only narrow the
  deterministic document and request scope. The feeder never interprets rule
  text or invokes a model.

target:
  documentValidation:
    schema:
      required: true

    document:
      schema:
        required: true

rules:
  type: List
  itemType:
    id:
      type: Text
      schema:
        required: true
      description: Stable unique rule identifier within this exact mandate state.

    text:
      type: Text
      schema:
        required: true
      description: Owner-readable instruction evaluated for each candidate action.
  description: |
    Optional ordered immutable rules. An absent or empty list means that no
    intelligent evaluation is required. Rule IDs must be non-blank and unique
    within the exact mandate state; the MyOS host enforces those constraints.

contracts:
  mandateGuarantorChannel:
    actor:
      type: MyOS/MyOS Admin Actor

  authorityHolderChannel:
    actor:
      type: MyOS/Principal Actor

  authorizedActorChannel:
    actor:
      type: MyOS/MyOS Agent Actor
      agentId:
        type: Text
        schema:
          required: true
        description: Stable MyOS identity of the acting specialist Agent.
      accountId:
        type: Text
        schema:
          required: true
        description: Account whose Principal is represented by this Agent.
      onBehalfOf:
        type: MyOS/Principal Actor
        schema:
          required: true
        description: Exact authority-holder Principal represented by the Agent.
